{% liquid
  assign bundle_handle = ''
  case product.handle
    when 'noise-buds-r1-true-wireless-earbuds'
      assign bundle_handle = 'naw-audio-charge-set-noise-buds-r1-belkin-braided-usb-c-2m'
    when 'belkin-boostcharge-braided-usb-c-to-usb-c-60w-cable-2m-black'
      assign bundle_handle = 'naw-audio-charge-set-noise-buds-r1-belkin-braided-usb-c-2m'
    when 'belkin-boostcharge-usb-c-to-usb-c-cable-2m-black'
      assign bundle_handle = 'naw-everyday-charge-duo-belkin-usb-c-2m-black-white'
    when 'belkin-boostcharge-usb-c-to-usb-c-cable-60w-2m-white'
      assign bundle_handle = 'naw-durability-duo-belkin-braided-black-standard-white-usb-c-2m'
  endcase
  assign related_bundle = blank
  if bundle_handle != blank
    assign related_bundle = all_products[bundle_handle]
  endif
%}
{% if related_bundle != blank %}
  <section class="naw-related-bundle" aria-labelledby="naw-related-bundle-heading-{{ section.id }}">
    <div class="naw-related-bundle__inner">
      <div class="naw-related-bundle__intro">
        <span class="naw-related-bundle__label">A THOUGHTFUL PAIRING</span>
        <h2 id="naw-related-bundle-heading-{{ section.id }}">Better together.</h2>
        <p>Explore a curated combination featuring this product. Bundle ordering opens once availability has been confirmed.</p>
      </div>
      <a class="naw-related-bundle__card" href="{{ related_bundle.url }}">
        <div class="naw-related-bundle__image">
          {% if related_bundle.featured_image != blank %}
            {{ related_bundle.featured_image | image_url: width: 540 | image_tag: loading: 'lazy', widths: '180, 360, 540', sizes: '(min-width: 750px) 180px, 130px', alt: related_bundle.title }}
          {% endif %}
        </div>
        <div class="naw-related-bundle__details">
          <span class="naw-related-bundle__kicker">BUNDLE COMBINATION</span>
          <h3>{{ related_bundle.title | escape }}</h3>
          <strong>{{ related_bundle.price | money }}</strong>
          <span class="naw-related-bundle__availability">Currently unavailable — explore details</span>
        </div>
        <span class="naw-related-bundle__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
{% endif %}
{% stylesheet %}
  .naw-related-bundle { background: #FAF7F2; color: #2C2C2E; padding: clamp(40px,5vw,68px) clamp(18px,4vw,60px); }
  .naw-related-bundle__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(24px,4vw,72px); align-items: center; }
  .naw-related-bundle__label, .naw-related-bundle__kicker { font-size: 11px; font-weight: 700; letter-spacing: .14em; color: #726B63; }
  .naw-related-bundle__intro h2 { font-family: var(--font-heading--family); color: #2C2C2E; font-size: clamp(30px,3vw,43px); letter-spacing: -.045em; margin: 10px 0; }
  .naw-related-bundle__intro p { max-width: 430px; font-size: 14px; line-height: 1.65; color: #68615B; margin: 0; }
  .naw-related-bundle__card { display: flex; align-items: center; gap: 20px; border: 1px solid #DED6CC; background: #fff; padding: 14px 19px 14px 14px; border-radius: 14px; text-decoration: none; color: #2C2C2E; min-width: 0; transition: border-color .2s ease, transform .2s ease; }
  .naw-related-bundle__card:hover { border-color: #BDB1A4; transform: translateY(-2px); color: #2C2C2E; }
  .naw-related-bundle__card:focus-visible { outline: 3px solid #E65100; outline-offset: 4px; }
  .naw-related-bundle__image { width: clamp(105px,15vw,150px); aspect-ratio: 1; flex: 0 0 auto; background: #FAF7F2; border-radius: 10px; display: grid; place-items: center; overflow: hidden; }
  .naw-related-bundle__image img { max-width: 100%; width: 100%; height: 100%; object-fit: contain; }
  .naw-related-bundle__details { min-width: 0; display: grid; gap: 7px; }
  .naw-related-bundle__details h3 { font-weight: 700; font-size: clamp(16px,1.6vw,21px); line-height: 1.3; margin: 0; letter-spacing: -.02em; }
  .naw-related-bundle__details strong { font-size: 18px; }
  .naw-related-bundle__availability { font-size: 12px; line-height: 1.5; color: #69625B; }
  .naw-related-bundle__arrow { margin-left: auto; align-self: start; font-size: 22px; flex: 0 0 auto; }
  @media (max-width: 840px) { .naw-related-bundle__inner { grid-template-columns: 1fr; gap: 22px; } }
  @media (max-width: 540px) { .naw-related-bundle__card { padding: 10px; gap: 12px; } .naw-related-bundle__image { width: 100px; } .naw-related-bundle__arrow { font-size: 17px; } .naw-related-bundle__details h3 { font-size: 15px; } .naw-related-bundle__details strong { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .naw-related-bundle__card { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "NAW Product Pairing",
  "enabled_on": {"templates": ["product"]},
  "settings": [],
  "presets": [{"name": "NAW Product Pairing"}]
}
{% endschema %}
