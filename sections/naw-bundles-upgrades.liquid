      "default": "Explore the other pairings"
    },
    {
      "type": "product",
      "id": "clean_pair_one",
      "label": "Clean Desk: keyboard and mouse"
    },
    {
      "type": "product",
      "id": "clean_pair_two",
      "label": "Clean Desk: mouse mat"
    },
    {
      "type": "product",
      "id": "audio_pair_one",
      "label": "Everyday Audio: earbuds"
    },
    {
      "type": "product",
      "id": "audio_pair_two",
      "label": "Everyday Audio: cable"
    },
    {
      "type": "text",
      "id": "pair_two_title",
      "label": "Second pairing name",
      "default": "Clean Desk"
    },
    {
      "type": "text",
      "id": "pair_two_description",
      "label": "Second pairing details",
      "default": "Keyboard and mouse + desk mat"
    },
    {
      "type": "text",
      "id": "pair_two_price",
      "label": "Second pairing planned price",
      "default": "₹1,649 offer"
    },
    {
      "type": "text",
      "id": "pair_three_title",
      "label": "Third pairing name",
      "default": "Everyday Audio"
    },
    {
      "type": "text",
      "id": "pair_three_description",
      "label": "Third pairing details",
      "default": "Noise Buds R1 + 3-in-1 cable"
    },
    {
      "type": "text",
