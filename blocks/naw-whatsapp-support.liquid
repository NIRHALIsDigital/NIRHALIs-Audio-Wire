{% liquid
  assign support_url = block.settings.url | default: 'https://wa.me/918452026751'
  assign support_name = block.settings.label | default: 'WhatsApp Support'
  assign support_phone = block.settings.phone | default: '+91 84520 26751'
%}
<div class="naw-whatsapp-contact" {{ block.shopify_attributes }}>
  <a class="naw-whatsapp-contact__link" href="{{ support_url }}" target="_blank" rel="noopener noreferrer" aria-label="Contact NIRHALIs Audio and Wire on WhatsApp at {{ support_phone | escape }}">
    <span class="naw-whatsapp-contact__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" role="img" focusable="false">
        <path d="M20.52 3.48A11.86 11.86 0 0 0 12.05 0 11.86 11.86 0 0 0 1.75 17.77L0 24l6.43-1.69a11.97 11.97 0 0 0 5.62 1.43h.01A11.86 11.86 0 0 0 24 11.86a11.82 11.82 0 0 0-3.48-8.38zM12.06 21.74h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.75.98 1-3.65-.24-.38A9.9 9.9 0 1 1 21.94 11.86c0 5.44-4.44 9.88-9.88 9.88zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48 1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"></path>
      </svg>
    </span>
    <span class="naw-whatsapp-contact__text">
      <strong>{{ support_name | escape }}</strong>
      <span>{{ support_phone | escape }}</span>
    </span>
  </a>
</div>

{% stylesheet %}
  .naw-whatsapp-contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    padding-block: 0.3rem;
  }
  .naw-whatsapp-contact__mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    background: #25D366;
    color: #ffffff;
  }
  .naw-whatsapp-contact__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .naw-whatsapp-contact__text strong { font-weight: 650; }
  .naw-whatsapp-contact__text span { font-size: 0.84rem; }
  .naw-whatsapp-contact__link:focus-visible {
    outline: 3px solid #E65100;
    outline-offset: 3px;
    border-radius: 4px;
  }
  .naw-whatsapp-contact__link:hover .naw-whatsapp-contact__text strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WhatsApp Support",
  "tag": null,
  "settings": [
    {"type": "text", "id": "label", "label": "Link label", "default": "WhatsApp Support"},
    {"type": "text", "id": "phone", "label": "Phone number", "default": "+91 84520 26751"},
    {"type": "url", "id": "url", "label": "WhatsApp link"}
  ]
}
{% endschema %}